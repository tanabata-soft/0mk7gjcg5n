{
  "keiyo": [
    {
      "text": "チーマイマイマイチーマイ",
      "startMs": 4900,
      "endMs": 19300
    },
    {
      "text": "夕凪の風が頬をかすめていくの",
      "startMs": 19300,
      "endMs": 23000
    },
    {
      "text": "恋の予感にただ胸が躍るの",
      "startMs": 23000,
      "endMs": 26600
    },
    {
      "text": "京葉線に揺られながらキミを待つ午後",
      "startMs": 26600,
      "endMs": 34000
    },
    {
      "text": "窓の外はオレンジ色に染まる海辺の街",
      "startMs": 34000,
      "endMs": 38600
    },
    {
      "text": "ときめきと期待を鞄にそっと詰め込んで",
      "startMs": 38600,
      "endMs": 42100
    },
    {
      "text": "早まる鼓動が静かな車内に響いてる",
      "startMs": 42100,
      "endMs": 49400
    },
    {
      "text": "だけど時々すれ違う二人の視線に",
      "startMs": 49400,
      "endMs": 53200
    },
    {
      "text": "切なさが胸の奥でチクリと痛むの",
      "startMs": 53200,
      "endMs": 57400
    },
    {
      "text": "言えない想いが言葉にならないままで",
      "startMs": 57400,
      "endMs": 61500
    },
    {
      "text": "ねえキミの心は今どこを向いているの",
      "startMs": 61500,
      "endMs": 67800
    },
    {
      "text": "恋する気持ちが止まらない奇跡みたいに",
      "startMs": 67800,
      "endMs": 71300
    },
    {
      "text": "キミと出会えたこの場所で笑い合いたいな",
      "startMs": 71300,
      "endMs": 76000
    },
    {
      "text": "チーマイマイマイチーマイ魔法をかけてよ",
      "startMs": 76000,
      "endMs": 83900
    },
    {
      "text": "ずっと隣にいさせてね離したくないの",
      "startMs": 83900,
      "endMs": 97500
    },
    {
      "text": "ポートタワーの灯りが街を照らし始めて",
      "startMs": 97500,
      "endMs": 104600
    },
    {
      "text": "二人の影がゆっくりと一つに重なっていく",
      "startMs": 104600,
      "endMs": 112800
    },
    {
      "text": "出会いがあれば別れもあると人は言うけれど",
      "startMs": 112800,
      "endMs": 121200
    },
    {
      "text": "今はこの瞬間だけを強く抱きしめていたい",
      "startMs": 121200,
      "endMs": 128400
    },
    {
      "text": "切なさを抱きしめて走り出すこの思い",
      "startMs": 128400,
      "endMs": 132000
    },
    {
      "text": "キミに届けと願うの夜空に咲く星のように",
      "startMs": 132000,
      "endMs": 136300
    },
    {
      "text": "どんな未来が待っていても恐れはしないから",
      "startMs": 136300,
      "endMs": 140300
    },
    {
      "text": "キミの手をギュッと握りしめて前を向くよ",
      "startMs": 140300,
      "endMs": 148000
    },
    {
      "text": "恋する気持ちが止まらない奇跡みたいに",
      "startMs": 148000,
      "endMs": 152000
    },
    {
      "text": "キミと出会えたこの場所でずっと笑い合おう",
      "startMs": 152000,
      "endMs": 156000
    },
    {
      "text": "チーマイマイマイチーマイ奇跡を起こして",
      "startMs": 156000,
      "endMs": 161000
    },
    {
      "text": "永遠に続くこの物語を始めよう",
      "startMs": 161000,
      "endMs": 174000
    },
    {
      "text": "チーマイマイマイチーマイ",
      "startMs": 174000,
      "endMs": 177500
    },
    {
      "text": "(La la la...)",
      "startMs": 177500,
      "endMs": 179722
    }
  ],
  "umi": [
    {
      "text": "潮風が頬を掠めて",
      "startMs": 15700,
      "endMs": 19000
    },
    {
      "text": "九十九里の砂が鳴る",
      "startMs": 19000,
      "endMs": 22800
    },
    {
      "text": "君の影遠く消えて",
      "startMs": 22800,
      "endMs": 26700
    },
    {
      "text": "波の音だけが残る",
      "startMs": 26700,
      "endMs": 29800
    },
    {
      "text": "恋の記憶は泡のよう",
      "startMs": 29800,
      "endMs": 34700
    },
    {
      "text": "波に呑まれて消えゆくの",
      "startMs": 34700,
      "endMs": 38600
    },
    {
      "text": "君への想い溢れ出して",
      "startMs": 38600,
      "endMs": 43800
    },
    {
      "text": "この胸を強く締めつける",
      "startMs": 43800,
      "endMs": 50200
    },
    {
      "text": "千葉の海に溶けてゆく",
      "startMs": 50200,
      "endMs": 53900
    },
    {
      "text": "サヨナラの言葉も言えずに",
      "startMs": 53900,
      "endMs": 59000
    },
    {
      "text": "ポートタワー霞んで見え",
      "startMs": 59000,
      "endMs": 65600
    },
    {
      "text": "季節の移ろいを感じる",
      "startMs": 65600,
      "endMs": 68900
    },
    {
      "text": "あの夏の煌めきはもう",
      "startMs": 68900,
      "endMs": 73200
    },
    {
      "text": "どこにも見当たらないの",
      "startMs": 73200,
      "endMs": 76300
    },
    {
      "text": "恋の記憶は泡のよう",
      "startMs": 76300,
      "endMs": 80600
    },
    {
      "text": "波に呑まれて消えゆくの",
      "startMs": 80600,
      "endMs": 85000
    },
    {
      "text": "君への想い溢れ出して",
      "startMs": 85000,
      "endMs": 89700
    },
    {
      "text": "この胸を強く締めつける",
      "startMs": 89700,
      "endMs": 96600
    },
    {
      "text": "千葉の海に溶けてゆく",
      "startMs": 96600,
      "endMs": 99900
    },
    {
      "text": "サヨナラの言葉も言えずに",
      "startMs": 99900,
      "endMs": 104400
    },
    {
      "text": "夕暮れの空に染まる",
      "startMs": 104400,
      "endMs": 110200
    },
    {
      "text": "茜色の切なさが刺さる",
      "startMs": 110200,
      "endMs": 114800
    },
    {
      "text": "もしも時間を戻せるなら",
      "startMs": 114800,
      "endMs": 118900
    },
    {
      "text": "なんて儚い願いを抱く",
      "startMs": 118900,
      "endMs": 125700
    },
    {
      "text": "秋風に吹かれながら",
      "startMs": 125700,
      "endMs": 130300
    },
    {
      "text": "一人きり歩き続ける",
      "startMs": 130300,
      "endMs": 133800
    },
    {
      "text": "チーマイマイマイチーマイ",
      "startMs": 133800,
      "endMs": 138700
    },
    {
      "text": "静かに幕は下りる",
      "startMs": 138700,
      "endMs": 142700
    }
  ],
  "yoru": [
    {
      "text": "(Ooh yeah, here we go!)",
      "startMs": 5900,
      "endMs": 12500
    },
    {
      "text": "人混みの中はぐれそうな手と手",
      "startMs": 12500,
      "endMs": 16100
    },
    {
      "text": "夜空に咲いた最初の光のシグナル",
      "startMs": 16100,
      "endMs": 19100
    },
    {
      "text": "キミの横顔照らす朱い光が",
      "startMs": 19100,
      "endMs": 22200
    },
    {
      "text": "胸の奥を強く締めつけるんだよ",
      "startMs": 22200,
      "endMs": 25200
    },
    {
      "text": "期待と不安の間を揺れ動いては",
      "startMs": 25200,
      "endMs": 28700
    },
    {
      "text": "言葉にできない想いが溢れ出しそう",
      "startMs": 28700,
      "endMs": 31900
    },
    {
      "text": "すれ違う視線に鼓動が跳ね上がる",
      "startMs": 31900,
      "endMs": 35000
    },
    {
      "text": "この瞬間がずっと続けばいいのに",
      "startMs": 35000,
      "endMs": 38300
    },
    {
      "text": "近くて遠いその距離を縮めたくて",
      "startMs": 38300,
      "endMs": 44800
    },
    {
      "text": "息もできないくらいに惹かれているから",
      "startMs": 44800,
      "endMs": 50800
    },
    {
      "text": "回る回る世界の中心で",
      "startMs": 50800,
      "endMs": 55500
    },
    {
      "text": "キミに恋した奇跡を叫ぶよ",
      "startMs": 55500,
      "endMs": 60100
    },
    {
      "text": "きらめく夜空誓い合う想いは",
      "startMs": 60100,
      "endMs": 63500
    },
    {
      "text": "決して色褪せない永遠の輝き",
      "startMs": 63500,
      "endMs": 68500
    },
    {
      "text": "チーマイマイマイチーマイ",
      "startMs": 68500,
      "endMs": 70200
    },
    {
      "text": "ハートがもう止まらないんだから",
      "startMs": 70200,
      "endMs": 102200
    },
    {
      "text": "風が運ぶ遠いお囃子の音に",
      "startMs": 102200,
      "endMs": 105400
    },
    {
      "text": "重ねるようにつぶやいた『好きだよ』",
      "startMs": 105400,
      "endMs": 108400
    },
    {
      "text": "キミの笑顔に答えを探すように",
      "startMs": 108400,
      "endMs": 111600
    },
    {
      "text": "まっすぐ見つめる私の瞳を見て",
      "startMs": 111600,
      "endMs": 114500
    },
    {
      "text": "切なささえも愛おしいと思える",
      "startMs": 114500,
      "endMs": 118300
    },
    {
      "text": "これが恋だとキミが教えてくれた",
      "startMs": 118300,
      "endMs": 121200
    },
    {
      "text": "つないだ手はもう絶対に離さない",
      "startMs": 121200,
      "endMs": 124500
    },
    {
      "text": "未来へと続くこの道を歩こう",
      "startMs": 124500,
      "endMs": 127500
    },
    {
      "text": "回る回る世界の中心で",
